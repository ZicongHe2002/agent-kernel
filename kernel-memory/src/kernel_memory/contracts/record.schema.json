      "required": [
        "schema_version",
        "record_type",
        "record_id",
        "created_at",
        "payload"
      ]
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.2.0"
        },
        "record_type": {
          "const": "commit"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pr_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "repo_uid": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "commit_oid": {
              "$ref": "#/$defs/GitOid"
            },
            "git_parent_oids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/GitOid"
              }
            },

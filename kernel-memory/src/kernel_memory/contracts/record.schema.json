      "required": [
        "schema_version",
        "record_type",
        "record_id",
        "created_at",
        "payload"
      ]
    },
    "pr_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.2.0"
        },
        "record_type": {
          "const": "pr_snapshot"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pr_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "previous_snapshot_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "observed_head": {
              "$ref": "#/$defs/GitOid"
            },
            "observed_base": {
              "$ref": "#/$defs/GitOid"
            },
            "commit_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"

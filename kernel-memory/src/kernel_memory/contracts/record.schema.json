{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kernel-memory:records:0.2.0",
  "title": "Kernel Memory v0.2.0 record contracts",
  "description": "P0 wire contracts; cross-record and trust invariants are normative in the implementation specification. No production system is included.",
  "oneOf": [
    {
      "$ref": "#/$defs/kernel"
    },
    {
      "$ref": "#/$defs/config"
    },
    {
      "$ref": "#/$defs/pr"
    },
    {
      "$ref": "#/$defs/pr_snapshot"
    },
    {
      "$ref": "#/$defs/commit"
    },
    {
      "$ref": "#/$defs/baseline"
    },
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/relation"
    },
    {
      "$ref": "#/$defs/decision"
    },
    {
      "$ref": "#/$defs/annotation"
    }
  ],
  "$defs": {
    "GitOid": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha1"
            },
            "hex": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "algorithm",
            "hex"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "hex": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "hex"
          ]
        }
      ]
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo_uid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "target_commit": {
          "$ref": "#/$defs/GitOid"
        },
        "tested_commit": {
          "$ref": "#/$defs/GitOid"
        },
        "tested_tree": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitOid"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkout_mode": {
          "enum": [
            "exact_commit",
            "integration_merge"
          ]
        },
        "merge_parent_oids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GitOid"
          }
        },
        "dirty": {
          "type": "boolean"
        },
        "patch_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "entrypoint": {
          "type": "string"
        },
        "implementation_overrides": {
          "type": "object"
        },
        "variant_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "repo_uid",
        "target_commit",
        "tested_commit",
        "tested_tree",
        "checkout_mode",
        "merge_parent_oids",
        "dirty",
        "patch_digest",
        "source_digest",
        "entrypoint",
        "implementation_overrides",
        "variant_digest"
      ]
    },
    "Change": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "change_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "component": {
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {},
        "after": {},
        "rationale": {
          "type": "string"
        },
        "extraction_source": {
          "enum": [
            "explicit",
            "heuristic",
            "unknown"
          ]
        },
        "attribution": {
          "enum": [
            "group_only",
            "isolated"
          ]
        }
      },
      "required": [
        "change_id",
        "component",
        "key",
        "before",
        "after",
        "rationale",
        "extraction_source",
        "attribution"
      ]
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "kind": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string"
        },
        "retention": {
          "enum": [
            "permanent",
            "retain_for_decision",
            "expiring"
          ]
        },
        "availability": {
          "enum": [
            "present",
            "expired",
            "missing"
          ]
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "uri",
        "sha256",
        "size_bytes",
        "media_type",
        "retention",
        "availability"
      ]
    },
    "Metric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "not_collected",
            "unsupported",
            "parse_error",
            "not_applicable"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "measurement",
            "static_estimate",
            "derived"
          ]
        },
        "scope": {
          "type": "string"
        },
        "source_artifact_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parser_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "parser_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "definition": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "value",
        "unit",
        "kind",
        "scope",
        "source_artifact_ref",
        "parser_id",
        "parser_version",
        "definition"
      ]
    },
    "Environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string"
        },
        "accelerator_model": {
          "type": "string"
        },
        "device_count": {
          "type": "integer",
          "minimum": 1
        },
        "topology": {
          "type": "string"
        },
        "software": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "execution_flags": {
          "type": "object"
        },
        "host_timer_environment": {
          "type": "object"
        },
        "unknown_required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "backend",
        "accelerator_model",
        "device_count",
        "topology",
        "software",
        "execution_flags",
        "host_timer_environment",
        "unknown_required_fields",
        "environment_hash"
      ]
    },
    "Protocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "measurement_scope": {
          "type": "string"
        },
        "timing_method": {
          "enum": [
            "host_synchronized",
            "device_profiler",
            "mock"
          ]
        },
        "include_compile": {
          "type": "boolean"
        },
        "include_transfers": {
          "type": "boolean"
        },
        "warmup": {
          "type": "integer",
          "minimum": 0
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "statistic": {
          "const": "median"
        },
        "quantile_method": {
          "const": "linear"
        },
        "input_suite_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "capture_profile": {
          "type": "boolean"
        },
        "protocol_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "protocol_id",
        "measurement_scope",
        "timing_method",
        "include_compile",
        "include_transfers",
        "warmup",
        "repetitions",
        "statistic",
        "quantile_method",
        "input_suite_hash",
        "capture_profile",
        "protocol_hash"
      ]
    },
    "Verifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verifier_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "reference_source_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "suite_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "tolerances": {
          "type": "object"
        },
        "nonfinite_policy": {
          "type": "string"
        },
        "verifier_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "verifier_id",
        "reference_source_hash",
        "suite_hash",
        "tolerances",
        "nonfinite_policy",
        "verifier_hash"
      ]
    },
    "Timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "recorded",
            "not_run",
            "error"
          ]
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "median_us": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "p90_us": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "samples_artifact_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "sample_count",
        "median_us",
        "p90_us",
        "samples_artifact_ref"
      ]
    },
    "Correctness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "pass",
            "fail",
            "error"
          ]
        },
        "cases_total": {
          "type": "integer",
          "minimum": 0
        },
        "cases_passed": {
          "type": "integer",
          "minimum": 0
        },
        "max_abs_error": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_rel_error": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "report_artifact_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "cases_total",
        "cases_passed",
        "max_abs_error",
        "max_rel_error",
        "report_artifact_ref"
      ]
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "min_confirm_pairs": {
          "type": "integer",
          "minimum": 1
        },
        "min_pair_speedup": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "max_normalized_iqr": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "max_baseline_drift_ratio": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "hard_resource_constraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "require_trusted_worker": {
          "type": "boolean"
        },
        "allow_fixture": {
          "type": "boolean"
        }
      },
      "required": [
        "policy_id",
        "min_confirm_pairs",
        "min_pair_speedup",
        "max_normalized_iqr",
        "max_baseline_drift_ratio",
        "hard_resource_constraints",
        "require_trusted_worker",
        "allow_fixture"
      ]
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.2.0"
        },
        "record_type": {
          "const": "kernel"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kernel_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "display_name": {
              "type": "string"
            },
            "adapter_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "contract_notes": {
              "type": "string"
            }
          },
          "required": [
            "kernel_id",
            "display_name",
            "adapter_id",
            "contract_notes"
          ]
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "record_id",
        "created_at",
        "payload"
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.2.0"
        },
        "record_type": {
          "const": "config"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kernel_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "config_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "problem_schema_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "problem_schema_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "problem": {
              "type": "object"
            },
            "config_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kernel_id",
            "config_id",
            "problem_schema_id",
            "problem_schema_digest",
            "problem",
            "config_hash",
            "tags"
          ]
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "record_id",
        "created_at",
        "payload"
      ]
    },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.2.0"
        },
        "record_type": {
          "const": "pr"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "config_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
            },
            "pr_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"

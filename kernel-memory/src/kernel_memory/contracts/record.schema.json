            "hypothesis": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "origin_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "config_ref",
            "pr_key",
            "repo_uid",
            "provider",
            "number",
            "title",
            "hypothesis",
            "origin_ref"
          ]
        }

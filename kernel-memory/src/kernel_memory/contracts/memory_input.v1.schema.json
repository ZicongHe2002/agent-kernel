{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kernel-memory:input:1.0.0",
  "title": "Kernel Memory public input v1.0.0",
  "description": "Portable result-only input. Ratios use 1 = 100%; times use microseconds; bandwidth uses decimal GB/s. Unknown measurements are null, never inferred or replaced by zero. HLO/LLO are availability labels only: raw compiler files, logs and attachments are not accepted. The JSON loader rejects duplicate keys and nonfinite numbers; reference consistency is checked by the importer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "kernels"],
  "properties": {
    "format": {"const": "kernel-memory-input"},
    "schema_version": {"const": "1.0.0"},
    "kernels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/kernel"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
      "description": "Stable identifier: lowercase letters, digits, underscore and hyphen; up to 80 characters."
    },
    "text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "label": {"type": "string", "minLength": 1, "maxLength": 256},
    "nullableText": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000},
    "nullableHttpsUrl": {
      "type": ["string", "null"],
      "maxLength": 4000,
      "format": "uri",
      "pattern": "^https://[^/?#\\s]+(?:[/?#][^\\s]*)?$"
    },
    "nullableCount": {"type": ["integer", "null"], "minimum": 0},
    "nullableRatio": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Fraction, where 1 = 100%; null means no measurement."
    },
    "nullableEstimateRatio": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Estimated fraction, where 1 = 100%. Values above 1 are retained because the model may overestimate work or traffic; null means unavailable."
    },
    "nullableBandwidth": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Decimal GB/s (10^9 bytes per second); null means unavailable."
    },
    "nullableLatency": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "description": "Microseconds; null means no valid timing."
    },
    "compilerStatus": {
      "type": "string",
      "enum": ["recorded", "not_collected", "unavailable"],
      "description": "Whether compiler information existed for this run. No raw HLO/LLO content or attachment is stored in memory."
    },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "dtype"],
      "properties": {
        "shape": {
          "type": "array",
          "maxItems": 10000,
          "description": "Tensor dimensions. An empty array denotes a scalar; dimensions are nonnegative integers or symbolic names.",
          "items": {
            "oneOf": [
              {"type": "integer", "minimum": 0},
              {"$ref": "#/$defs/label"}
            ]
          }
        },
        "dtype": {"$ref": "#/$defs/label"}
      }
    },
    "signature": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 10000,
      "propertyNames": {"$ref": "#/$defs/label"},
      "additionalProperties": {"$ref": "#/$defs/tensor"}
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_signature", "output_signature"],
      "properties": {
        "input_signature": {"$ref": "#/$defs/signature"},
        "output_signature": {"$ref": "#/$defs/signature"},
        "parameters": {
          "type": "object",
          "description": "Optional JSON operation parameters, such as scale, causal mask or layout. Do not embed source code, raw compiler files, logs or attachments."
        }
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernel_id", "description", "algorithms"],
      "properties": {
        "kernel_id": {"$ref": "#/$defs/id"},
        "description": {"$ref": "#/$defs/text"},
        "algorithms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/algorithm"}
        }
      }
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm_id", "method_summary", "summary_author", "shapes"],
      "properties": {
        "algorithm_id": {"$ref": "#/$defs/id"},
        "display_name": {"$ref": "#/$defs/label"},
        "method_summary": {
          "$ref": "#/$defs/text",
          "description": "Human- or AI-authored explanation of the actual method. Describe only what is supported by the input code and records."
        },
        "summary_author": {"type": "string", "enum": ["human", "agent", "unknown"]},
        "shapes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/shape"}
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape_id", "problem", "attempts"],
      "properties": {
        "shape_id": {"$ref": "#/$defs/id"},
        "problem": {"$ref": "#/$defs/problem"},
        "baseline_run_id": {
          "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}],
          "description": "Optional run_id of a baseline run within this shape. Omit or use null if no baseline is available."
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/attempt"}
        }
      }
    },
    "code": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Optional source location only. Source text, compiler IR and binary artifacts are not accepted.",
      "properties": {
        "repository_url": {"$ref": "#/$defs/nullableHttpsUrl"},
        "path": {"$ref": "#/$defs/nullableText"},
        "entrypoint": {"$ref": "#/$defs/nullableText"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "candidate", "runs"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/id"},
        "candidate": {"$ref": "#/$defs/label"},
        "summary": {"$ref": "#/$defs/nullableText"},
        "parameters": {
          "type": "object",
          "description": "Optional JSON implementation tuning parameters, such as tile sizes or scheduling flags. These may vary between attempts while the fixed problem stays the same. Do not embed source code or raw compiler files."
        },
        "pr_url": {"$ref": "#/$defs/nullableHttpsUrl"},
        "commit": {
          "type": ["string", "null"],
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "description": "Actual Git commit ID (SHA-1 or SHA-256), not a source snapshot digest. Use null if unknown."
        },
        "code": {"$ref": "#/$defs/code"},
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/run"}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device": {"$ref": "#/$defs/nullableText"},
        "software": {
          "type": "object",
          "maxProperties": 10000,
          "propertyNames": {"$ref": "#/$defs/label"},
          "additionalProperties": {"type": "string", "maxLength": 4000},
          "description": "Optional software names and versions."
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {"$ref": "#/$defs/nullableText"},
        "timing_method": {"$ref": "#/$defs/nullableText"},
        "warmup": {"$ref": "#/$defs/nullableCount"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "result"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "recorded_at": {"type": ["string", "null"], "format": "date-time"},
        "environment": {"$ref": "#/$defs/environment"},
        "measurement": {"$ref": "#/$defs/measurement"},
        "result": {"$ref": "#/$defs/result"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_status", "correctness", "latency_us"],
      "properties": {
        "execution_status": {
          "type": "string",
          "enum": ["succeeded", "compile_error", "runtime_error", "timeout", "cancelled", "not_run"]
        },
        "correctness": {"type": "string", "enum": ["pass", "fail", "not_run"]},
        "latency_us": {"$ref": "#/$defs/nullableLatency"},
        "p90_latency_us": {"$ref": "#/$defs/nullableLatency"},
        "samples": {"$ref": "#/$defs/nullableCount"},
        "mfu": {
          "$ref": "#/$defs/nullableRatio",
          "description": "Useful model FLOPs / elapsed seconds / device peak FLOP/s; 0.7484 means 74.84%."
        },
        "mfu_executed_estimate": {
          "$ref": "#/$defs/nullableEstimateRatio",
          "description": "Estimated executed FLOPs / elapsed seconds / device peak FLOP/s. Kept separate from useful MFU."
        },
        "mxu": {
          "$ref": "#/$defs/nullableRatio",
          "description": "Measured runtime matrix-unit utilization. Do not substitute static compiler estimates."
        },
        "attention_mxu_static": {
          "$ref": "#/$defs/nullableRatio",
          "description": "Static compiler estimate of attention matrix-unit utilization; distinct from runtime MXU utilization."
        },
        "roofline_efficiency": {
          "$ref": "#/$defs/nullableEstimateRatio",
          "description": "Achieved performance divided by the roofline bound for the same operation and hardware; 1 = 100%."
        },
        "logical_bandwidth_gbps": {
          "$ref": "#/$defs/nullableBandwidth",
          "description": "Logical tensor bytes / elapsed seconds in decimal GB/s; this is not measured HBM traffic."
        },
        "logical_bandwidth_utilization": {
          "$ref": "#/$defs/nullableEstimateRatio",
          "description": "Estimated logical bandwidth divided by peak bandwidth. Values above 1 can occur due to reuse or cache effects."
        },
        "hbm_bandwidth_gbps": {
          "$ref": "#/$defs/nullableBandwidth",
          "description": "Measured HBM traffic / elapsed seconds in decimal GB/s; null when unmeasured."
        },
        "hbm_bandwidth_utilization": {
          "$ref": "#/$defs/nullableRatio",
          "description": "Measured HBM bandwidth divided by device peak HBM bandwidth; 1 = 100%."
        },
        "hlo": {"$ref": "#/$defs/compilerStatus"},
        "llo": {"$ref": "#/$defs/compilerStatus"},
        "failure_reason": {"$ref": "#/$defs/nullableText"}
      }
    }
  }
}
